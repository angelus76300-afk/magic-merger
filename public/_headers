# The World runs Claude's spell code. Its page gets no network at all and can
# only load scripts from this site (connect-src and webrtc are closed, so
# a program cannot reach the network by either). It is also loaded in a sandboxed iframe
# without allow-same-origin, so it cannot read the game page or its storage.
/world
  Content-Security-Policy: default-src 'none'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'none'; worker-src 'none'; webrtc 'block'; frame-ancestors 'self'
/world.html
  Content-Security-Policy: default-src 'none'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'none'; worker-src 'none'; webrtc 'block'; frame-ancestors 'self'
# The test run of new programs (3.3): spell code again, same rules, except
# that since 4.2 the frame runs it in a Web Worker it makes from a blob
# (src/sim/checkframe.ts): a blob worker has the frame's opaque origin and
# inherits this policy, so it has no network either.
/check
  Content-Security-Policy: default-src 'none'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'none'; worker-src blob:; webrtc 'block'; frame-ancestors 'self'
/check.html
  Content-Security-Policy: default-src 'none'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'none'; worker-src blob:; webrtc 'block'; frame-ancestors 'self'

# The sandboxed iframe has an opaque origin, so its module scripts are cross
# origin requests: allow them. These files are public anyway.
/assets/*
  Access-Control-Allow-Origin: *
