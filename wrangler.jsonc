{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "magic-merger",
  // So CI needs only the token (docs/SETUP.md, "Previews").
  "account_id": "9df6f62fed82968200f6388eb51fb6ff",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // The Worker serves the built frontend and only runs its own code for /api/*.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "magic-merger",
      // Created on 2026-11-01. A fork needs its own id from `npx wrangler d1 create magic-merger`.
      "database_id": "2faca013-6f31-4c46-8bf1-08d5691d89ff",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    // See docs/SETUP.md for what each call costs.
    "MERGE_MODEL": "claude-opus-5-5",
    "MERGE_EFFORT": "low",
    "DESCRIBE_MODEL": "claude-haiku-5-5",
    "SPELL_MODEL": "claude-opus-5-5",
    "SPELL_MODEL_SMALL": "claude-haiku-5-5",
    "SPELL_SMALL_UP_TO": "grand",
    // Repairs fix one error in a program that exists: always the small model.
    "REPAIR_MODEL": "claude-haiku-5-5",
    "SPELL_EFFORT": "medium",
    // Everyone together, the admin included; the Console limit is the same $50.
    "BUDGET_USD": "50",
    // 3.4. Each invite's monthly allowance; the admin can top one up.
    "INVITE_CAP_USD": "5",
    // 3.3. Looks at three Spell Lab frames and guesses the vote.
    "JUDGE_MODEL": "claude-haiku-5-5",
    // Dollars a day that votes, the judge and failed test runs may spend on rewrites.
    "REWRITE_BUDGET_USD": "0.5",
    // Legendary and cosmic spells: drafted by SPELL_MODEL_SMALL at once, written
    // by SPELL_MODEL through the Batch API at half price. "0" asks SPELL_MODEL at once.
    "BIG_SPELLS_BATCH": "1",
    // 3.7. Dollars a month the refresh of the legacy library may spend (held
    // before each batch is sent); scripts/refresh-runner.ts decides each program.
    "REFRESH_BUDGET_USD": "8",
    // 3.4.1. The repository the feedback routine works on. With the secrets
    // GITHUB_TOKEN, ROUTINE_URL and ROUTINE_TOKEN, the admin can send an idea
    // to Claude from the Feedback tab (docs/FEEDBACK.md). A fork sets its own.
    "GITHUB_REPO": "angelus76300-afk/magic-merger",
    // 4.2. Dollars a day that writing new items at the merge may spend, for
    // everyone together (worker/ahead.ts); past it, items are written on
    // first use, as before. "0" writes nothing ahead.
    "AHEAD_DAILY_USD": "1.5",
    // 4.4.5 part C. Dollars a month the new wonder a day may spend (held
    // before each call, inside BUDGET_USD); "0" in WONDERS stops the daily call.
    "WONDER_BUDGET_USD": "2",
  },
  // 4.2: the programs of new items, written at the merge by a background job
  // that outlives the response (a big model's program can take a minute).
  // Messages are taken with no wait to fill a batch, ten at a time: a batch
  // waits for its slowest job (a small program is about 20 s), so with four
  // the fifth item of a burst waited 34 s before it started (production run).
  "queues": {
    "producers": [{ "binding": "WRITES", "queue": "magic-merger-writes" }],
    "consumers": [{ "queue": "magic-merger-writes", "max_batch_size": 10, "max_batch_timeout": 0, "max_retries": 1 }],
  },
  // Collects the programs the Batch API has written, and reads GitHub for the
  // ideas sent to Claude (3.4.1).
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": { "enabled": true },
  // 4.5: a preview of each pull request before it is merged (docs/SETUP.md,
  // "Previews"). One staging Worker with its own D1, refreshed every night
  // from a copy of the live one with accounts, sessions, invites and emails
  // stripped (scripts/staging-copy.mjs), its own queue, and $2 a month. CI
  // uploads each pull request as a version with its own address,
  // pr-<n>-magic-merger-staging.angelus76300.workers.dev, and deploys main
  // to the staging address every night. Nothing here touches production.
  "env": {
    "staging": {
      "name": "magic-merger-staging",
      "preview_urls": true,
      "workers_dev": true,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "magic-merger-staging",
          "database_id": "d1024ed3-1c00-4fd4-a1b4-3a54c211e616",
          "migrations_dir": "migrations",
        },
      ],
      "vars": {
        "MERGE_MODEL": "claude-opus-5-5",
        "MERGE_EFFORT": "low",
        "DESCRIBE_MODEL": "claude-haiku-5-5",
        "SPELL_MODEL": "claude-opus-5-5",
        "SPELL_MODEL_SMALL": "claude-haiku-5-5",
        "SPELL_SMALL_UP_TO": "grand",
        "REPAIR_MODEL": "claude-haiku-5-5",
        "SPELL_EFFORT": "medium",
        // $2 a month for the previews together, the admin included; the
        // nightly copy keeps staging's own spend, so the month holds.
        "BUDGET_USD": "2",
        "INVITE_CAP_USD": "2",
        "JUDGE_MODEL": "claude-haiku-5-5",
        "REWRITE_BUDGET_USD": "0.1",
        "BIG_SPELLS_BATCH": "1",
        "REFRESH_BUDGET_USD": "0",
        "AHEAD_DAILY_USD": "0.3",
        "WONDER_BUDGET_USD": "0",
        // Nothing runs on its own: the owner tries a change, the admin can still ask.
        "WONDERS": "0",
        "EVOLVE": "0",
        "DAILY_CHALLENGES": "0",
        "STAGING": "1",
        // No ideas are sent to Claude from a preview.
        "GITHUB_REPO": "",
      },
      "queues": {
        "producers": [{ "binding": "WRITES", "queue": "magic-merger-staging-writes" }],
        "consumers": [{ "queue": "magic-merger-staging-writes", "max_batch_size": 10, "max_batch_timeout": 0, "max_retries": 1 }],
      },
      "triggers": { "crons": ["*/10 * * * *"] },
    },
  },
}
