{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "magic-merger",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // The Worker serves the built frontend and only runs its own code for /api/*.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "magic-merger",
      // Created on 2026-11-01. A fork needs its own id from `npx wrangler d1 create magic-merger`.
      "database_id": "2faca013-6f31-4c46-8bf1-08d5691d89ff",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    // See docs/SETUP.md for what each call costs.
    "MERGE_MODEL": "claude-opus-5-5",
    "MERGE_EFFORT": "low",
    "DESCRIBE_MODEL": "claude-haiku-5-5",
    "SPELL_MODEL": "claude-opus-5-5",
    "SPELL_MODEL_SMALL": "claude-haiku-5-5",
    "SPELL_SMALL_UP_TO": "grand",
    // Repairs fix one error in a program that exists: always the small model.
    "REPAIR_MODEL": "claude-haiku-5-5",
    "SPELL_EFFORT": "medium",
    // Everyone together, the admin included; the Console limit is the same $50.
    "BUDGET_USD": "50",
    // 3.4. Each invite's monthly allowance; the admin can top one up.
    "INVITE_CAP_USD": "5",
    // 3.3. Looks at three Spell Lab frames and guesses the vote.
    "JUDGE_MODEL": "claude-haiku-5-5",
    // Dollars a day that votes, the judge and failed test runs may spend on rewrites.
    "REWRITE_BUDGET_USD": "0.5",
    // Legendary and cosmic spells: drafted by SPELL_MODEL_SMALL at once, written
    // by SPELL_MODEL through the Batch API at half price. "0" asks SPELL_MODEL at once.
    "BIG_SPELLS_BATCH": "1",
    // 3.7. Dollars a month the refresh of the legacy library may spend (held
    // before each batch is sent); scripts/refresh-runner.ts decides each program.
    "REFRESH_BUDGET_USD": "8",
    // 3.4.1. The repository the feedback routine works on. With the secrets
    // GITHUB_TOKEN, ROUTINE_URL and ROUTINE_TOKEN, the admin can send an idea
    // to Claude from the Feedback tab (docs/FEEDBACK.md). A fork sets its own.
    "GITHUB_REPO": "angelus76300-afk/magic-merger",
  },
  // Collects the programs the Batch API has written, and reads GitHub for the
  // ideas sent to Claude (3.4.1).
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": { "enabled": true },
}
