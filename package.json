{
  "name": "magic-merger",
  "version": "1.0.0",
  "description": "An Infinite Craft style game about merging magic",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787",
    "typecheck": "tsc -p tsconfig.json && tsc -p worker/tsconfig.json",
    "build": "npm run typecheck && vite build",
    "preview": "npm run build && wrangler dev --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply magic-merger --local",
    "db:migrate:remote": "wrangler d1 migrations apply magic-merger --remote",
    "deploy": "npm run build && wrangler d1 migrations apply magic-merger --remote && wrangler deploy",
    "test": "esbuild scripts/sim-test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sim-test.mjs --log-level=warning && node node_modules/.cache/sim-test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/angelus76300-afk/magic-merger.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/angelus76300-afk/magic-merger/issues"
  },
  "homepage": "https://github.com/angelus76300-afk/magic-merger#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "acorn": "^8.19.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "@types/three": "^0.170.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "wrangler": "^4.152.0"
  },
  "private": true,
  "type": "module"
}
