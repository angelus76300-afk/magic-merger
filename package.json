{
  "name": "magic-merger",
  "version": "1.0.0",
  "description": "An Infinite Craft style game about merging magic",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787",
    "typecheck": "tsc -p tsconfig.json && tsc -p worker/tsconfig.json && tsc -p scripts/tsconfig.json",
    "build": "npm run typecheck && vite build",
    "preview": "npm run build && wrangler dev --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply magic-merger --local",
    "db:migrate:remote": "wrangler d1 migrations apply magic-merger --remote",
    "deploy": "node -e \"if(!process.env.GITHUB_ACTIONS&&!process.env.MM_DEPLOY_BY_HAND){console.error('Production deploys only from main, by the Deploy workflow (docs/DAILY.md, Deploys). The owner alone, for a first setup or an emergency: MM_DEPLOY_BY_HAND=1 npm run deploy');process.exit(1)}\" && npm run build && wrangler d1 migrations apply magic-merger --remote && wrangler deploy",
    "test": "esbuild scripts/sim-test.ts scripts/challenge-worker.ts --bundle --platform=node --format=esm --outdir=node_modules/.cache --out-extension:.js=.mjs --log-level=warning && node node_modules/.cache/sim-test.mjs",
    "test:worker": "node --no-warnings scripts/worker-test.mjs",
    "test:risk": "node scripts/risk-test.mjs && node scripts/gate-test.mjs && node scripts/gate-prstate-test.mjs && node scripts/rewrite-one-test.mjs && node scripts/session-guard-test.mjs",
    "evolve": "esbuild scripts/evolve-runner.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/evolve.mjs --log-level=warning && node node_modules/.cache/evolve.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "wonders": "esbuild scripts/wonder-runner.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/wonder-runner.mjs --log-level=warning && node node_modules/.cache/wonder-runner.mjs",
    "challenges": "esbuild scripts/challenge-runner.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/challenge-runner.mjs --log-level=warning && node node_modules/.cache/challenge-runner.mjs",
    "refresh": "esbuild scripts/refresh-runner.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/refresh-runner.mjs --external:playwright --log-level=warning && node node_modules/.cache/refresh-runner.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/angelus76300-afk/magic-merger.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/angelus76300-afk/magic-merger/issues"
  },
  "homepage": "https://github.com/angelus76300-afk/magic-merger#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "acorn": "^8.19.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.20.5",
    "@types/three": "^0.170.0",
    "eslint": "^9.36.0",
    "eslint-plugin-import-x": "^4.16.1",
    "globals": "^14.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.44.1",
    "vite": "^6.4.5",
    "wrangler": "^4.152.0"
  },
  "private": true,
  "type": "module"
}
